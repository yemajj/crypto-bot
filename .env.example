# Copy this file to `.env` and fill in your own values.
# NEVER commit your real .env.

# --- Runtime ---
CRYPTOBOT_ENV=dev          # dev | paper | live (live disabled in v1)
CRYPTOBOT_LOG_LEVEL=INFO

# --- Exchange (read-only keys recommended for v1) ---
# In v1 we only fetch market data; trade-enabled keys are NOT needed yet.
EXCHANGE_NAME=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_TESTNET=true

# --- Storage ---
CRYPTOBOT_DB_URL=sqlite:///./data/cryptobot.sqlite
CRYPTOBOT_DATA_DIR=./data
CRYPTOBOT_LOG_DIR=./logs

# --- Optional notifications (Phase 5) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Hard kill switch ---
# Touch this file to immediately halt any running bot.
CRYPTOBOT_KILL_SWITCH_FILE=./KILL_SWITCH
